# ==========================================================================
# Copie este arquivo para ".env.local" e preencha os valores.
# Na Vercel: Project Settings -> Environment Variables (adicione os mesmos).
# ==========================================================================

# --- Supabase (Project Settings -> API no painel do Supabase) ---
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sua-anon-key

# Chave "service_role" do Supabase. NUNCA exponha isto no navegador.
# Usada apenas no servidor (painel admin) para gravar a configuracao.
SUPABASE_SERVICE_ROLE_KEY=sua-service-role-key

# --- Senha do painel /admin ---
ADMIN_PASSWORD=troque-esta-senha

# --- Token para o Google Ads buscar o CSV de conversoes (upload agendado HTTPS) ---
# Uma string secreta qualquer (aleatoria). A URL fica:
#   https://SEU-SITE/api/vendas/export?token=ESTE-TOKEN&days=90
EXPORT_TOKEN=troque-por-um-token-aleatorio

# ==========================================================================
# Checkout de renovação (/checkout/[usuario]) — TODAS secretas, só no servidor.
# ==========================================================================

# --- Painel Sigma (renovação da conta) ---
SIGMA_API_TOKEN=xxxxx
# SIGMA_BASE_URL=https://sistema.ftspanel.vip/api/integration/v1   # opcional (default)
# SIGMA_OWNER_ID=xxxxx                                             # opcional

# --- PIX (FastDePix) ---
FASTDEPIX_API_KEY=xxxxx
# FASTDEPIX_BASE_URL=https://fastdepix.space/api/v1               # opcional (default)
